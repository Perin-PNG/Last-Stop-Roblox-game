--!strict
-- One config table per entity. Behaviors: Hunter, Listener, Watcher, Sentry, Ambusher,
-- plus a few special ones. Speeds are multiplied by Tuning.Entities.TierSpeedMultiplier.

export type EntityDef = {
	id: string,
	name: string,
	behavior: "Hunter"
		| "Listener"
		| "Watcher"
		| "Sentry"
		| "Ambusher"
		| "Latecomer"
		| "Drowned"
		| "Lure"
		| "Headlights"
		| "OtherBus",
	speed: number, -- chase speed
	patrolSpeed: number?,
	sight: number?, -- range in studs (Hunter, Sentry)
	cone: number?, -- degrees
	hearing: number?, -- multiplier on noise radius it can hear
	telegraph: string, -- caption text
	telegraphSound: string?, -- key in Config.Audio
	counter: string,
	height: number,
	color: Color3,
	coat: boolean?,
	faceless: boolean?,
	flareStuns: boolean?,
	rig: ("figure" | "mannequin" | "scarecrow" | "car")?,
	count: number?, -- how many spawn (Watcher groups)
	countByTier: { number }?,
	respectsShelter: boolean?, -- loses you inside a building marked Shelter
	nametag: boolean?, -- wears a random rider's display name (the Resident)
}

