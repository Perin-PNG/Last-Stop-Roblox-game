--!strict
-- Anomaly definitions. An anomaly swaps a tagged slot in a stop (or the bus) to a wrong
-- variant. Stop builders tag slot objects with the attribute AnomalySlot = "<slot>" and may
-- pre-build hidden variant objects named after the anomaly id (attribute AnomalyVariant).
--
-- op:
--   variant   show the hidden object(s) tagged AnomalyVariant = id
--   swap      hide the slot object, show the variant
--   rotate    rotate the slot object around Y by params.degrees
--   text      set every TextLabel in the slot to params.text
--   names     like text, but fills in the display names of players in this server
--   lightOn   enable lights in the slot / lightOff disable / lightBlink blink them
--   spin      spin the slot object around its Y axis
--   counter   a number in the slot counts up
--   breathe   the slot object lifts and falls
--   sound     a looping sound (params.sound) with a caption
--   custom    the stop builder's own function (registered by id)
--   bus       handled by the bus systems
-- severity: Ambient raises Dread nearby; Warning telegraphs a threat; Hazard downs whoever
-- touches or comes close; Lure looks like loot but is a trap (Tier 2+ only).

export type AnomalyDef = {
	id: string,
	name: string,
	stop: string, -- stop id, or "bus"
	slot: string,
	category: "Object" | "Text" | "Light" | "Sound" | "People" | "Space" | "Bus",
	severity: "Ambient" | "Warning" | "Hazard" | "Lure",
	tell: string,
	op: string,
	params: { [string]: any }?,
	minTier: number?,
	hazardRadius: number?,
	report: string, -- the Anomaly Catalog entry, written as an HCTA incident report
}

